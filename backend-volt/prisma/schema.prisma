datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum PlanType {
  STRENGTH
  HYPERTROPHY
  WEIGHT_LOSS
  OTHER
}


model User {
  id            String     @id @default(uuid())
  clerkId       String     @unique
  email         String?    @unique
  firstName     String?    // null until updated in profile
  lastName      String?    // null until updated in profile
  height        Int?       // Stored in centimeters
  activePlanId  String?    
  isAdmin       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime?  @updatedAt
  
  weights       Weight[]
  workoutPlans  WorkoutPlan[]
  workoutLogs   WorkoutLog[]
  nutritionLogs NutritionLog[]

  @@map("users")
}

model Exercise {
  id               String  @id @default(uuid())
  slug             String  @unique  // e.g., "Alternate_Incline_Dumbbell_Curl"
  name             String
  force            String? // pull, push, static
  level            String? // beginner, intermediate, expert
  mechanic         String? // isolation, compound
  equipment        String?
  category         String?
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  images           String[]
  createdAt        DateTime @default(now())

  workoutDayExercises WorkoutDayExercise[]
  exerciseLogs        ExerciseLog[]

  @@map("exercises")
}

// User's weight in pounds
model Weight {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @default(now())
  amount    Float    // pounds

  user      User     @relation(fields: [userId], references: [id])
  
  @@map("weights")
}

// A named workout plan, e.g. "PPL", "Bro Split", "My Custom Split"
model WorkoutPlan {
  id        String    @id @default(uuid())
  userId    String
  name      String
  type      PlanType?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  
  user      User      @relation(fields: [userId], references: [id])

  workoutDays WorkoutDay[]

  @@map("workout_plans")
}

// A single day within a plan, e.g. "Push", "Pull", "Legs"
model WorkoutDay {
  id            String      @id @default(uuid())
  workoutPlanId String
  name          String
  order         Int // order within the plan
  
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  exercises   WorkoutDayExercise[]
  workoutLogs WorkoutLog[]

  @@unique([workoutPlanId, order])
  @@map("workout_days")
}

// Exercises assigned to a workout day template
model WorkoutDayExercise {
  id            String     @id @default(uuid())
  workoutDayId  String
  exerciseId    String
  order         Int
  targetSets    Int?
  targetRepsMin Int?
  targetRepsMax Int?
  restSeconds   Int?

  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise      Exercise   @relation(fields: [exerciseId], references: [id])
  @@unique([workoutDayId, order])
  @@map("workout_day_exercises")
}

// A recorded workout session
model WorkoutLog {
  id           String      @id @default(uuid())
  userId       String
  workoutDayId String?     // nullable — user may log an ad-hoc session
  date         DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id])
  workoutDay   WorkoutDay? @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)

  exerciseLogs ExerciseLog[]

  @@map("workout_logs")
}

// One exercise performed within a workout session
model ExerciseLog {
  id           String     @id @default(uuid())
  exerciseId   String
  workoutLogId String
  notes        String?

  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  sets SetLog[]

  @@map("exercise_logs")
}

// An individual set: set number, reps performed, weight used
model SetLog {
  id            String      @id @default(uuid())
  exerciseLogId String
  setNumber     Int
  reps          Int
  weight        Float // in lbs

  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@map("set_logs")
}

// A daily nutrition record for a user
model NutritionLog {
  id     String   @id @default(uuid())
  userId String
  date   DateTime @default(now()) @db.Date
  user   User     @relation(fields: [userId], references: [id])

  meals Meal[]
  
  @@unique([userId, date])
  @@map("nutrition_logs")
}

// An individual meal entry within a nutrition log
model Meal {
  id             String          @id @default(uuid())
  nutritionLogId String
  name           String
  calories       Float
  protein        Float // grams
  carbs          Float // grams
  fat            Float // grams

  nutritionLog   NutritionLog @relation(fields: [nutritionLogId], references: [id], onDelete: Cascade)

  @@map("meals")
}
